# Copy to .env. Part 1 does not need a model or API key.
# Set these for a tool-capable OpenAI model if using the supplied adapter dependency.
OPENAI_API_KEY=
MODEL_NAME=
# Optional: base URL of an OpenAI compatible provider (for example OpenRouter). Empty means OpenAI.
OPENAI_BASE_URL=
# Sampling temperature. Empty means do not send it.
MODEL_TEMPERATURE=1
# Reasoning effort sent with tool calls (for example none). Empty means do not send it.
MODEL_REASONING_EFFORT=none
# Use your own paths; keep persistent data out of git.
HELPDESK_STORAGE_DIR=local-storage
HELPDESK_TICKET_DIR=outputs/tickets
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
